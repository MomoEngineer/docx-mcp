# Example environment variables for docx-mcp.
# Copy this file to `.env` and adjust the values. `.env` is NOT committed.
#
# IMPORTANT (secrets policy, see docs/documentation-standards.md, Section 5):
# No tokens/passwords/API keys in code, MCP client config, or committed files.
# docx-mcp has no external service dependency that would need one.

# --- Workspace boundary (filesystem access, from Phase 1) ---
# os.pathsep-separated list of allowed roots. Empty => access is denied.
DOCX_MCP_ALLOWED_ROOTS=

# --- Logging ---
# Level of the server log (stderr), case-insensitive.
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL. Applied when the server
# starts (python -m docx_mcp); an invalid value refuses to start with a
# clear error instead of silently falling back to a default.
DOCX_MCP_LOG_LEVEL=INFO
